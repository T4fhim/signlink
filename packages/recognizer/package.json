{
  "name": "@signlnk/recognizer",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Runs the exported SignLnk recognizer (ONNX) with onnxruntime-web",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./decoder": "./src/decoder/index.ts",
    "./client": "./src/client.ts",
    "./parity": "./src/parity.ts",
    "./stats": "./src/stats.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-model": "node scripts/check-model.ts"
  },
  "dependencies": {
    "@signlnk/landmarks": "workspace:*",
    "@signlnk/schemas": "workspace:*",
    "onnxruntime-web": "1.30.0"
  }
}
